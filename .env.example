PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce-backend
JWT_SECRET=your_jwt_secret
JWT_ACCESS_EXPIRE=7d
CLIENT_ORIGIN=http://localhost:3000,http://localhost:8000,http://localhost:5173,https://kakadikro.com,https://www.kakadikro.com,https://admin.kakadikro.com
COOKIE_SAME_SITE=lax
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=kakadikroproduct
S3_PRESIGNED_URL_EXPIRES_IN=3600
S3_BASE_URL=https://kakadikroproduct.s3.ap-south-1.amazonaws.com
CLOUDFRONT_BASE_URL=
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@kakadikro.com
# Quote the password when it contains # or spaces. Otherwise the # is treated as a comment.
SMTP_PASS="your_smtp_password"
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@Kaka_Dikro
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/kaka.dikro
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/share/1BRUZeNZr6/
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
CHECKOUT_BUSINESS_NAME=Kaka Dikro
# Shipping fee in paise. 0 means free shipping. Do not put a guessed delivery estimate in the description.
SHIPPING_FEE_PAISE=0
SHIPPING_METHOD_ID=standard
SHIPPING_METHOD_NAME=Standard Delivery
SHIPPING_METHOD_DESCRIPTION=
SHIPPING_COD_ENABLED=false
SHIPPING_COD_FEE_PAISE=0
# Optional comma-separated Indian pincodes. Leave SERVICEABLE empty to allow every valid Indian pincode except BLOCKED.
SHIPPING_SERVICEABLE_PINCODES=
SHIPPING_BLOCKED_PINCODES=
